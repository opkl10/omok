# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Site URL (for social sharing and SEO)
NEXT_PUBLIC_BASE_URL="https://omeroko.netlify.app"

# Media Upload - Cloudinary (REQUIRED for Netlify/Vercel deployment)
# Get these from https://cloudinary.com (free tier available)
# Without these, file uploads will fail on serverless platforms
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
